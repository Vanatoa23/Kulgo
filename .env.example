# =============================================================================
# Kulgo Environment Configuration
# Copy to `.env` and populate all required secrets before running in production.
# Never commit `.env` with real credentials.
# =============================================================================

# --- Runtime & Origin ---
NODE_ENV=production
PORT=4000
# Public origin of the Kulgo web app (used for CORS & partner invite links).
# Example: https://app.kulgo.eu (or http://localhost:5173 for local Vite dev)
WEB_ORIGIN=
# Host port exposed by the Nginx web container in infra/docker-compose.yml
WEB_PORT=8080

# --- Security & Session Signing (REQUIRED in production) ---
# Generate with: openssl rand -hex 32
# Production enforces >= 32 characters and rejects weak/default patterns.
SESSION_SECRET=

# --- ArcadeDB (Private Network Only — never expose port 2480 publicly) ---
# Use http://127.0.0.1:2480 for local dev; infra/docker-compose.yml overrides to http://arcadedb:2480.
ARCADEDB_URL=http://127.0.0.1:2480
ARCADEDB_DATABASE=kulgo
ARCADEDB_USER=root
# Generate with: openssl rand -base64 24
# Production enforces >= 12 characters and rejects weak/default patterns.
ARCADEDB_PASSWORD=

# --- Rate Limiting & Request Body Limits ---
# Sliding window duration in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per IP per window on /api/v1/auth/login and /api/v1/auth/register (default: 20; 0 disables)
RATE_LIMIT_AUTH_MAX=20
# Max requests per IP per window on /api/v1/workspace/import (default: 10; 0 disables)
RATE_LIMIT_IMPORT_MAX=10
# Max JSON payload size in bytes for standard /api/* routes (default: 1048576 = 1 MiB)
MAX_JSON_BODY_BYTES=1048576
# Max payload size in bytes for /api/v1/workspace/import (default: 5242880 = 5 MiB)
MAX_IMPORT_BODY_BYTES=5242880

# --- Live Disruption Monitoring & AI API Centre (Optional — €0 MVP) ---
# Enable 3x daily scheduled sweeps (06:00, 12:00, 17:00 UTC)
INTELLIGENCE_SWEEP_ENABLED=false
# Provider fallback chain: Gemini (free tier primary) -> Groq (free fallback) -> OpenAI / OpenRouter
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Transactional alert email providers (Resend for instant RED, Brevo for daily AMBER digest)
RESEND_API_KEY=
BREVO_API_KEY=
ALERT_FROM_EMAIL=alerts@kulgo.eu

