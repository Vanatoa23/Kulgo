{
  "name": "@kulgo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "start:memory": "tsx src/test-server.ts",
    "db:bootstrap": "tsx --env-file-if-exists=../../.env src/db/bootstrap.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:privacy": "vitest run tests/privacy-boundary.test.ts",
    "test:integration": "vitest run tests/integration/arcadedb.integration.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@kulgo/engine": "workspace:*",
    "@kulgo/shared": "workspace:*",
    "hono": "^4.7.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3"
  }
}
